# Copy to .env (or set in your host's dashboard). Never commit the real values.

# Public URL the site is served on, no trailing slash. Used for the share preview tags.
PUBLIC_URL=https://example.ie
PORT=3000

# Password for Klaudia's diary at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Where bookings are stored. On Railway, leave this unset and the attached volume is used.
DATA_DIR=./data

# ---- Stripe deposit (off until the secret key is set) ----
# Developers > API keys. Use sk_test_... to try it, then sk_live_...
STRIPE_SECRET_KEY=
# Developers > Webhooks > your endpoint (https://YOUR-DOMAIN/stripe/webhook) > Signing secret
STRIPE_WEBHOOK_SECRET=

# Secret part of Klaudia's Apple Calendar link (/calendar/<token>.ics). Long and random; change it to revoke the link.
CALENDAR_TOKEN=
