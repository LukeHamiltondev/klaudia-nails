# Copy to .env (or set in your host's dashboard). Never commit the real values.

# Public URL the site is served on, no trailing slash. Used for the share preview tags.
PUBLIC_URL=https://example.ie
PORT=3000

# Password for Klaudia's diary at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Where bookings are stored. On Railway, leave this unset and the attached volume is used.
DATA_DIR=./data
